# ==================================================
# 명품익스프레스 (CodeMove) .gitignore
# Spring Boot + Thymeleaf + Oracle 11g XE / Figma Make 프로토타입 / AI 모듈
# ==================================================

# ---------- 보안: 계정·비밀번호·API Key (절대 커밋 금지) ----------
.env
.env.*
!.env.example
application-local.yml
application-local.properties
application-dev.yml
application-dev.properties
application-prod.yml
application-prod.properties
application-secret.yml
application-secret.properties
**/src/main/resources/secret/
*.pem
*.key
*.p12
*.jks
credentials.json

# ---------- Java ----------
*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# 패키지 파일 (빌드 래퍼 jar는 커밋)
*.jar
*.war
*.nar
*.ear
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# ---------- Gradle ----------
.gradle/
build/
!gradle/wrapper/
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Maven ----------
target/
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- Spring Boot ----------
logs/
*.log.*
HELP.md

# 업로드 파일 (고객 영상, 후기 사진, 견적서 PDF 등 - 개인정보 포함 가능)
uploads/
upload/
files/

# ---------- IDE ----------
# IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- 프로토타입 (React + Vite) ----------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- AI 모듈 (Python / OpenCV / YOLO) ----------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.pt
*.onnx
runs/

# ---------- 압축 파일 ----------
*.zip
*.tar.gz
*.rar
*.7z
# Figma Make 프로토타입 원본은 커밋
!prototype/**/*.zip

# ---------- DB 덤프 (실데이터 포함 가능) ----------
*.dump
dump/
backup/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Claude Code 개인 설정 ----------
.claude/settings.local.json
