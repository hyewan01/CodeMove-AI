# 사용법: 이 파일을 복사해 application-local.yml 로 저장한 뒤 실제 값을 입력하세요.
# application-local.yml 은 .gitignore 에 등록되어 GitHub에 올라가지 않습니다.
spring:
  datasource:
    # SID 방식: jdbc:oracle:thin:@<호스트>:<포트>:<SID>
    url: jdbc:oracle:thin:@<HOST>:<PORT>:<SID>
    username: <USERNAME>
    password: <PASSWORD>

# 간편 로그인 앱 키 (등록 방법: README.md "간편 로그인 설정"). 비워 두면 해당 버튼은 "준비 중" 안내만 표시합니다.
codemove:
  social:
    # 콜백 주소 앞부분. 비우면 현재 접속 주소(http://localhost:8080). 애플은 https 주소만 허용
    redirect-base:
    kakao:
      client-id: <카카오 REST API 키>
      client-secret: <카카오 Client Secret (사용 설정 시)>
    naver:
      client-id: <네이버 Client ID>
      client-secret: <네이버 Client Secret>
    apple:
      client-id: <Services ID (예: com.codemove.login)>
      team-id: <Apple 팀 ID>
      key-id: <Sign in with Apple 키 ID>
      # .p8 파일 경로 또는 -----BEGIN PRIVATE KEY----- 로 시작하는 내용
      private-key: <AuthKey_XXXX.p8 경로>
